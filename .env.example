# Supabase — Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-from-supabase-settings-api"

NEXTAUTH_SECRET="generate-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# Resend — resend.com/api-keys (newsletter confirmation + admin sends)
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="Spill the News <newsletter@yourdomain.com>"

# Shared secret for the /api/newsletter/send-due cron endpoint — generate
# any random string and configure your external scheduler to send it as
# the `x-cron-secret` header.
CRON_SECRET="generate-a-random-string"
