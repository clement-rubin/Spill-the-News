# Supabase — Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-from-supabase-settings-api"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-from-supabase-settings-api"

# HMAC key for newsletter unsubscribe links — generate a random 32-byte string
APP_SECRET="generate-a-random-32-byte-string"
# Public site URL, used as the base for links in emails
SITE_URL="http://localhost:3000"

# Gmail SMTP (newsletter confirmation + admin sends) — needs 2-Step
# Verification on the account, then myaccount.google.com/apppasswords
GMAIL_USER="your-address@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
# Optional display name shown as the sender (default: Spill the News)
EMAIL_FROM_NAME="Spill the News"

# Shared secret for the /api/newsletter/send-due cron endpoint — generate
# any random string; the Supabase pg_cron job (docs/newsletter-setup.md)
# sends it as the `x-cron-secret` header.
CRON_SECRET="generate-a-random-string"
