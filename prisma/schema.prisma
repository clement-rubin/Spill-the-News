generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  articles     Article[]
  episodes     Episode[]
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  coverImage  String?
  body        String
  category    String
  publishedAt DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
}

model Episode {
  id           String   @id @default(cuid())
  title        String
  description  String
  externalLink String
  coverImage   String?
  publishedAt  DateTime @default(now())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
}
